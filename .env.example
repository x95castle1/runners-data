# Copy to .env and edit. Everything here is optional.

# Your goal race. Drives the countdown + weekly plan context on the dashboard.
RACE_NAME=Marathon
RACE_DATE=2026-11-01

# Where the SQLite database lives (inside the container this path is volume-mounted).
RUNS_DB=data/runs.db

# Distance unit for display: mi or km
DISPLAY_UNIT=mi

# Your timezone. The container is UTC without it, which puts the race countdown
# a day off in the evening.
TZ=America/Chicago
